# API (REST)
VITE_API_BASE_URL=/api

# Contact form backend (Yandex Cloud Function). Unset -> form runs in demo mode.
# Full endpoint URL, WITHOUT any path (direct function URL treats a path as the
# function id). Example: https://functions.yandexcloud.net/<function-id>
VITE_CONTACT_API_URL=

# Canonical origin of the deployed site — no trailing slash.
# Drives <link rel="canonical">, hreflang alternates, Open Graph / Twitter
# URLs, JSON-LD, robots.txt and sitemap.xml. Moving to a custom domain is this
# one variable (plus the VITE_SITE_URL secret in GitHub Actions).
VITE_SITE_URL=https://example.com

# Ownership tokens. Optional — the meta tag is emitted only when the value is
# set. Google Search Console -> "HTML tag"; Yandex Webmaster -> "Мета-тег".
VITE_GOOGLE_SITE_VERIFICATION=
VITE_YANDEX_VERIFICATION=

# OpenAPI / Swagger — URL or path for `npm run generate:api`
# Example: https://api.example.com/openapi.json or ./openapi.json
OPENAPI_SPEC_URL=./openapi.json
